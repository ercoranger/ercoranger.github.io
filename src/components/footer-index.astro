---
const { locale = "en" } = Astro.props;

const currentPath = Astro.url.pathname;

const zhUrl = currentPath.replace(/^\/(en|zh)(?=\/|$)/, "/zh");
const enUrl = currentPath.replace(/^\/(en|zh)(?=\/|$)/, "/en");
---

<footer class="ee-footer">
    <div class="ee-footer-links">
        <div class="lang-change footer-left">
            <a
                href={zhUrl}
                class:list={{ active: locale === "zh" }}
                aria-current={locale === "zh" ? "page" : undefined}
            >
                中
            </a>
            <span> / </span>
            <a
                href={enUrl}
                class:list={{ active: locale === "en" }}
                aria-current={locale === "en" ? "page" : undefined}
            >
                EN
            </a>
        </div>

        <a
            class="footer-right"
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.instagram.com/ercoffice_by_ercolai/"
        >
            Instagram
        </a>
    </div>
</footer>

<div class="ee-disclaimer">
    <p>©by ercoffice / 2026</p>
</div>
