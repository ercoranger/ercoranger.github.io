---
import site from "../content/site.json";

const {
    locale = "en",
    headerItems = ["about"],
    showElementMenu = true,
} = Astro.props;

const content = site[locale] ?? site.en;

// 固定頁面網址
const routes = {
    about: `/${locale}/about/`,
    workList: `/${locale}/works/all-list/`,
    exhibitions: `/${locale}/exhibitions/`,
    shop: `/${locale}/shop/`,
};

// 取得連結名稱
const getLabel = (key) => {
    // 四種 Mode 從 site.json 讀取
    if (content.modes?.[key]) {
        return content.modes[key];
    }

    // 其他網站導覽從 navigation 讀取
    return content.navigation?.[key] ?? key;
};

// 取得連結網址
const getHref = (key) => {
    // 固定頁面
    if (routes[key]) {
        return routes[key];
    }

    // Mode 分類
    if (content.modes?.[key]) {
        return `/${locale}/works/${key}/`;
    }

    return null;
};

// 根據 Props 建立導覽列表
const navigation = headerItems
    .map((key) => ({
        key,
        label: getLabel(key),
        href: getHref(key),
    }))
    .filter((item) => item.href !== null);
---

<header>
    <!-- 頂層黑條識別 -->
    <div class="ee-header grid-12">
        <a class="ee-logo-link" href={`/${locale}/`}>
            <img class="ee-logo" src="/imgs/header-logo.svg" alt="ercoffice" />
        </a>

        {navigation.length > 0 && (
            <nav class="ee-link" aria-label="Header navigation">
                {navigation.map((item, index) => (
                    <a href={item.href} class={`ee-link-${index + 1}`}>
                        {item.label}
                    </a>
                ))}
            </nav>
        )}
    </div>

    <!-- 工作室簡述 ＋ 五行作品分類 -->
    {showElementMenu && (
        <>
            <nav class="ee-menu">
                <div class="ee-left-menu">
                    <h3 class="studio-title">{content.studioTitle}</h3>
                    <p class="studio-intro">{content.studioIntro}</p>
                </div>

                <div class="v-line">
                    <hr />
                </div>

                <!-- Metal -->
                <div class="ee-right-menu">
                    <h6 class="menu-title">{content.metal}</h6>
                    <ul>
                        <li>
                            <a href={`/${locale}/Rift/`}>
                                {locale === "zh" ? "峽谷屏風" : "Rift"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Waterfall/`}>
                                {locale === "zh" ? "流水架" : "Waterfall"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Asterisk/`}>
                                {locale === "zh" ? "星盤" : "Asterisk"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Hopper/`}>
                                {locale === "zh" ? "容器系列" : "Hopper"}
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Earth -->
                <div class="ee-right-menu">
                    <h6 class="menu-title">{content.earth}</h6>
                    <ul>
                        <li>
                            <a href={`/${locale}/Fieldstone/`}>
                                {locale === "zh" ? "積石" : "Fieldstone"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Mineralloop/`}>
                                {locale === "zh" ? "礦物循環" : "Mineralloop"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Neo-Stone-Age/`}>
                                {locale === "zh" ? "新石紀" : "Neo Stone Age"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Binary-jugs/`}>
                                {locale === "zh" ? "陶瓷列印" : "Binary jugs"}
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Wood -->
                <div class="ee-right-menu">
                    <h6 class="menu-title">{content.wood}</h6>
                    <ul>
                        <li>
                            <a href={`/${locale}/Ginkgo/`}>
                                {locale === "zh" ? "銀杏椅" : "Ginkgo"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Tomaat/`}>
                                {locale === "zh" ? "蕃茄皮革" : "Tomaat"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Ikebana/`}>
                                {locale === "zh" ? "生之花" : "Ikebana"}
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Fire -->
                <div class="ee-right-menu">
                    <h6 class="menu-title">{content.fire}</h6>
                    <ul>
                        <li>
                            <a href={`/${locale}/Magma/`}>
                                {locale === "zh" ? "絨岩燈" : "Magma"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Lava-and-/`}>
                                {locale === "zh" ? "熔融實驗" : "Lava and..."}
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Water -->
                <div class="ee-right-menu">
                    <h6 class="menu-title">{content.water}</h6>
                    <ul>
                        <li>
                            <a href={`/${locale}/Tafoni/`}>
                                {locale === "zh" ? "滴石花器" : "Tafoni"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Biorock/`}>
                                {locale === "zh" ? "硓𥑮石" : "Biorock"}
                            </a>
                        </li>
                        <li>
                            <a href={`/${locale}/Revolve/`}>
                                {locale === "zh" ? "水刀系列" : "Revolve"}
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <div class="menu-bottom-line">
                <hr />
            </div>
        </>
    )}
</header>

<script>
    // 隱藏作品自身連結，藉由比對URL
    const removeCurrentPageLink = () => {
        const currentPath = window.location.pathname.replace(/\/+$/, "");

        const anchors = document.querySelectorAll(".ee-right-menu ul a");

        for (const anchor of anchors) {
            const linkPath = new URL(anchor.href).pathname.replace(/\/+$/, "");

            if (linkPath === currentPath) {
                anchor.closest("li")?.remove();
                break;
            }
        }
    };

    removeCurrentPageLink();
</script>
