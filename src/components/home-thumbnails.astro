---
const { locale } = Astro.props;
---

<section id="thumbnails" class="ee-overview">
    <div class="ee-index-row grid-12">
        <a href={`/${locale}/Fieldstone/`}>
            <img
                src="/imgs/Fieldstone.webp"
                title="積石 Fieldstone"
                alt="Fieldstone"
            />
        </a>

        <a href={`/${locale}/Ginkgo/`}>
            <img src="/imgs/Ginkgo.webp" title="銀杏椅 Ginkgo" alt="Ginkgo" />
        </a>

        <a href={`/${locale}/Rift/`}>
            <img src="/imgs/Rift.webp" title="峽谷屏風 Rift" alt="Rift" />
        </a>
    </div>

    <div class="ee-index-row grid-12">
        <a href={`/${locale}/Magma/`}>
            <img src="/imgs/Magma.webp" title="絨岩燈 Magma" alt="Magma" />
        </a>

        <a href={`/${locale}/Tafoni/`}>
            <img src="/imgs/Tafoni.webp" title="滴石系列 Tafoni" alt="Tafoni" />
