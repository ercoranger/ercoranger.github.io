---
import site from "../content/site.json";

const { locale = "en", activeMode = null } = Astro.props;

const content = site[locale] ?? site.en;
const modes = Object.entries(content.modes);
---

<nav class="mode-navigation" aria-label="Works categories">
    {modes.map(([mode, label], index) => (
        <>
            {index > 0 && <span aria-hidden="true">/</span>}

            <a
                href={`/${locale}/works/${mode}/`}
                class:list={{ "is-active": activeMode === mode }}
                aria-current={activeMode === mode ? "page" : undefined}
            >
                {label}
            </a>
        </>
    ))}
</nav>
