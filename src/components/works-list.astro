---
const { works = [], locale = "en" } = Astro.props;

const formatValue = (value) => {
    if (Array.isArray(value)) return value.join(", ");
    return value ? String(value) : "";
};
---

<div class="project-page works-list">
    {works.map((work) => (
        <a class="list-row grid-12" href={`/${locale}/${work.slug}/`}>
            <!--列表內容開始-->
            <span class="col-2">{work.year}</span>

            <span class="list-title col-2">
                {locale === "zh"
                    ? work.title_zh || work.title_en
                    : work.title_en}
            </span>

            <span class="col-3 mobile-invis">{formatValue(work.object)}</span>

            <span class="col-3 list-details">
                {formatValue(work.material)}

                {work.technique && <small>{formatValue(work.technique)}</small>}
            </span>

            <span class="col-3 mobile-invis">
                {formatValue(work.dimensions)}
            </span>

            <span class="col-2 list-image">
                {work.image && <img src={work.image} alt="" loading="lazy" />}
            </span>
        </a>
    ))}
</div>
