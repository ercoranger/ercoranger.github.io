---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import FooterIndex from "../components/footer-index.astro";
import "../styles/global.css";

const {
    title = "ercoffice",
    locale = "en",
    footerType = "default",
    headerLink = "about",
} = Astro.props;
---

<html id="top" lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
    </head>

    <body>
        <Header locale={locale} headerLink={headerLink} />

        <main>
            <slot /> <!--pages 的內容-->
        </main>

        {footerType === "index" ? <FooterIndex /> : <Footer />}
    </body>
</html>
