---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import "../styles/animation.css";

const {
    title = "ercoffice",
    locale = "en",
    footerType = "default",
    headerItems = ["about"],
    showElementMenu = true,
} = Astro.props;
---

<html id="top" lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
    </head>

    <body>
        <Header
            locale={locale}
            headerItems={headerItems}
            showElementMenu={showElementMenu}
        />

        <main>
            <slot /> <!--pages 的內容-->
        </main>

        <Footer locale={locale} footerType={footerType} />
    </body>
</html>
