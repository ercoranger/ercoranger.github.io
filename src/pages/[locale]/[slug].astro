---
import BaseLayout from "../../layouts/base-layout.astro";
import ProjectMenu from "../../components/project-menu.astro";
import { locales } from "astro:schema";

export function getStaticPaths() {
    const objects = import.meta.glob("../../content/projects/*.md", {
        eager: true,
    });

    return Object.entries(objects).flatMap(([path, module]) => {
        const object = module.frontmatter;

        const filename = path.split("/").pop()?.replace(".md", "");

        const slug = filename;

        return [
            {
                params: {
                    locale: "en",
                    slug,
                },
                props: {
                    object,
                    Content: module.default,
                },
            },
            {
                params: {
                    locale: "zh",
                    slug,
                },
                props: {
                    object,
                    Content: module.default,
                },
            },
        ];
    });
}

const { locale } = Astro.params;
const { object, Content } = Astro.props;

const titles =
    locale === "zh" && object.title_zh
        ? `${object.title_en} / ${object.title_zh}`
        : object.title_en;

const title =
    locale === "zh" && object.title_zh ? object.title_zh : object.title_en;

const material =
    locale === "zh" && object.material_zh
        ? object.material_zh
        : object.material;

const technique =
    locale === "zh" && object.technique_zh
        ? object.technique_zh
        : object.technique;
---

<BaseLayout
    title={`${titles} — ercoffice`}
    locale={locale}
    headerItems={["workList", "about"]}
    image={object.image}
>
    <div class={`project-page lang-${locale} grid-12`}>
        <!--招喚左側選單-->
        <ProjectMenu lang={locale} />

        <main class="project-content">
            <section class="project-header grid-12">
                <div class="project-header-image">
                    <img src={object.image} alt={title} title={titles} />
                </div>

                <!--header 右邊資訊-->
                <div class="project-header-info">
                    <div>
                        <p class="project-header-title">{title}</p>
                        <h6 class="project-year">{object.year}</h6>
                    </div>

                    <!-- timeline & awards-->
                    {object.timeline?.length > 0 && (
                        <div class="project-timeline">
                            {object.timeline.map((item) => (
                                <div class="timeline-item">
                                    <span class="timeline-year">
                                        {item.year} &nbsp;
                                    </span>

                                    <span class="timeline-event">
                                        {item.link ? (
                                            <a
                                                href={item.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {item.event}
                                            </a>
                                        ) : (
                                            item.event
                                        )}
                                    </span>
                                </div>
                            ))}
                        </div>
                    )}

                    <p class="mtrl-info">
                        {material}, {technique}
                        <br />
                        {object.dimensions}
                    </p>
                </div>
            </section>

            <Content />
        </main>
    </div>
</BaseLayout>
