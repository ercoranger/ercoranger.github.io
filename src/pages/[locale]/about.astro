---
import BaseLayout from "../../layouts/base-layout.astro";

export function getStaticPaths() {
    return [{ params: { locale: "en" } }, { params: { locale: "zh" } }];
}

const { locale = "en" } = Astro.params;
---

<BaseLayout
    title="About - ercoffice by Erco Lai"
    locale={locale}
    headerItems={["workList"]}
    footerType="index"
>
    <div class="project-page grid-12">
        <!-- 獨立左側選單列 -->
        <aside class="about-menu mobile-off">
            <ul>
                <li>
                    <a href="mailto:hello@ercoffice.net">Email</a>
                </li>

                <li>
                    <a href={`/${locale}/Exhibitions/`}>
                        <span class="lang-en">Exhibitions</span>
                        <span class="lang-zh">展覽記錄</span>
                    </a>
                </li>

                <li>
                    <a
                        href="https://drive.google.com/drive/folders/1eLl6lkIzNF7iF7ZSYUgnxeBCQjENkT9v?usp=sharing"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="lang-en">Press kits</span>
                        <span class="lang-zh">媒體包</span>

                        <img src="/imgs/arrow.svg" class="arrow" alt="" />
                    </a>
                </li>
            </ul>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="project-content">
            <!-- 01 ERCO LAI -->

            <section class="project-section grid-12 mobile-off" id="erco-lai">
                <div class="col-12">
                    <p class="title-XL lang-en">
                        My design approach is listening to materials through
                        hands-on experiments and shaping them in the most
                        "natural" way. Through my practice, I attempt to find
                        beauty in the balance between design control and
                        material spontaneity
                    </p>

                    <p class="title-XL lang-zh">
                        "我透過製作理解材質，也透過物質重新思考造形。讓設計的意圖與材料的自發性彼此協商，在不斷實驗之中尋找事物形成的另一種可能"
                    </p>
                </div>
            </section>

            <section class="about-section grid-12" id="">
                <h6 class="col-12">About</h6>
                <p class="col-12 project-title">Erco Lai</p>
            </section>

            <section class="project-section grid-12" id="">
                <div class="about-text-block col-7">
                    <p class="about-text lang-en">
                        Erco Lai is an interdisciplinary artist / designer
                        working across sculptural objects, spatial
                        installations, and experimental fabrication. His
                        practice explores the relationships between matter,
                        form, and craft, drawing from geological formations,
                        natural forces, and industrial processes.
                        <br />
                        <br />
                        Combining hands-on experimentation with computational
                        tools, he approaches making as a dialogue between
                        physical intuition and technological precision. Rather
                        than imposing predetermined shapes upon materials, he
                        embraces their resistance, deformation, and
                        unpredictability as part of the creative process. For
                        Lai, making is both a means of artistic expression and a
                        way of understanding the material world.
                        <br />
                        <br />
                        <span class="mobile-off">
                            Working within the conditions of the post-industrial
                            era, he reinterprets materials and manufacturing
                            techniques as artistic media. His practice moves
                            from intimate objects to large-scale installations,
                            exploring how gravity, movement, and environmental
                            forces can shape new forms and spatial experiences.
                        </span>
                    </p>

                    <p class="about-text lang-zh">
                        賴亭安 / Erco Lai
                        是一位設計創作者，創作涵蓋雕塑、空間裝置、材料研究與實驗性製造。他立足於後工業時代的生產條件，從地質生成、自然力量與工業製程中尋找造形的線索，探索物質如何在不同的技術與環境條件下形成獨特的表現語言。出身工業設計背景的他，不將設計僅視為解決問題或實現預設形式的工具，而是一種透過材料、工藝與製作過程展開的藝術探索。在身體直覺與技術精準之間，他持續思考人為意圖如何與物質自身的特性相互作用，共同參與形式的生成。
                        <br />
                        <br />
                        <span class="mobile-off">
                            透過動手實驗、運算設計與數位製造，他探索工業技術在藝術創作中的可能性，觀察材料如何回應壓力、限制與變化，讓阻力、變形與不可預測的反應成為造形的條件。對他而言，工藝不僅是既有技法的延續，也是一種透過雙手、工具與物質累積的感知與知識。隨著創作尺度從日常物件延伸至雕塑與大型空間裝置，重力、運動、結構及周遭環境也逐漸成為造形的重要條件。他試圖讓作品不只是被放置於空間中的物件，而能回應場域，呈現物質與外力相互作用的過程。在自然與人為、機械與直覺、控制與偶然之間，他持續尋找不同的賦形方式，將造物視為理解世界、參與物質循環的過程。
                        </span>
                    </p>
                </div>

                <div class="about-image col-5">
                    <img
                        src="/imgs/portrait.jpg"
                        alt="Erco Lai portrait"
                        loading="lazy"
                    />
                </div>
            </section>

            <section class="project-section grid-12 mobile-off" id="">
                <!-- AWARDS -->
                <div class="about-text-block col-6">
                    <p class="about-title">Award & Grant</p>

                    <div class="project-text">
                        <p>2023 Stimuleringsfonds Opencall Milan Design Week</p>
                        <p>2023 The Index Project — Nominees</p>
                        <p>2022 STARTS Prize, Ars Electronica — Nomination</p>
                        <p>2022 Guiltlessplastic — Finalist</p>
                        <p>2022 Creative Industries Fund NL — Starting Grant</p>
                        <p>
                            2021 MA Industrial Design Department Award —
                            Nomination
                        </p>
                        <p>2018 Golden Pin Design Award, Taiwan</p>
                    </div>
                </div>

                <!-- EXHIBITIONS -->
                <div class="about-text-block col-6">
                    <p class="about-title">Exhibitions</p>

                    <div class="project-text">
                        <p>2024 Milan Design Week — ISOLA</p>
                        <p>2024 Stockholm Furniture Fair — Greenhouse</p>
                        <p>2023 London Design Week — Mint Gallery</p>
                        <p>
                            2023 International Steel Sculpture Festival,
                            Kaohsiung
                        </p>
                        <p>2023 Maison&Objet, Paris</p>
                        <p>2023 ALCOVA, Milan</p>
                        <p>2022 Object Rotterdam</p>
                        <p>2021 Dutch Design Week</p>
                    </div>
                </div>

                <!-- COLLABORATIONS -->
                <div class="about-text-block col-12">
                    <p class="about-title">Selected Clients & Collaborations</p>

                    <p class="project-text">
                        Blue City (NL), Biophilica (UK), TPCreative (TW), Binary
                        Pottery (TW), Hevo deco (TW), 20MM (TW)
                    </p>
                </div>
            </section>

            <!-- 02 ERCOFFICE -->

            <section class="project-section grid-12" id="ercoffice">
                <div class="about-image col-12">
                    <img
                        title="Photo: Ronald Smits"
                        src="/imgs/ercoffice.jpg"
                        alt="ercoffice studio"
                        loading="lazy"
                    />
                </div>
            </section>
            <section class="project-section grid-12 mobile-off" id="">
                <div class="col-12">
                    <p class="title-XL lang-en">
                        A design office aims to cooperate with material-focused
                        developers, scientists or start-ups to elevate future
                        materials from experiments into the context of daily
                        life by giving matter meaningful forms.
                    </p>

                    <p class="title-XL lang-zh">
                        "我們不只是試著製造不同的事物，也試著重新理解事物可以如何被製造"
                    </p>
                </div>
            </section>

            <section class="about-section grid-12" id="">
                <h6 class="col-12">About</h6>
                <p class="col-12 project-title">ercoffice</p>
            </section>

            <section class="project-section grid-12" id="">
                <div class="about-text-block col-7">
                    <p class="about-text lang-en">
                        ercoffice is a research-led design practice working
                        across material research, craft experimentation, object
                        development, and spatial design. Guided by Make Things
                        Like Earth, the studio explores methods of form-giving
                        in the post-industrial era. Operating at the
                        intersection of science, craft, industry, nature, and
                        culture, ercoffice approaches design as a way of
                        connecting different forms of knowledge and technology.
                        Rather than treating nature merely as a source of
                        inspiration or industry solely as a means of production,
                        the studio investigates how matter is shaped and
                        transformed through both natural processes and
                        industrial manufacturing, seeking new relationships
                        between the two.
                        <br />
                        <br />
                        <span class="mobile-off">
                            The studio reimagines Factory as an open space for
                            experimentation, bringing together different forms
                            of knowledge and making. From traditional
                            craftsmanship to digital fabrication, ercoffice
                            explores the relationships between Crafts, Matter,
                            and Form. Rather than following a fixed sequence,
                            these aspects inform one another: material
                            properties may inspire new techniques, making
                            processes may generate unexpected forms, and formal
                            intentions may reshape how things are made. Working
                            with material developers, scientists, engineers,
                            manufacturers, and cultural institutions, the studio
                            connects research with practical applications,
                            translating its findings into objects, products, and
                            spatial interventions through independent inquiries
                            and commissioned projects.
                        </span>
                    </p>

                    <p class="about-text lang-zh">
                        ercoffice / 鈋谷賦形事物所
                        是一個研究導向的設計實踐，工作涵蓋材料研究、工藝實驗、物件開發與空間設計。以
                        Make Things Like Earth
                        為思想方向，探索後工業時代的賦形造物之法。我們遊走於科學、工藝、工業、自然與文化之間，將設計視為連結不同知識與技術的方法。不僅從自然界尋找造形的線索，也關注工業製程中物質如何被改變與轉化，試圖重新理解自然作用與人為製造之間的關係。
                        <br />
                        <br />
                        <span class="mobile-off">
                            我們將 Factory / 工廠
                            重新想像為一個開放的實驗場域，讓不同領域的知識與製造技術在此相遇。從傳統手工到數位製造，我們持續探索工藝、物質與造形（Crafts,
                            Matter,
                            Form）之間的相互關係。三者並非依序進行的設計步驟，而是在實驗中彼此影響：物質的特性可能啟發新的工藝，製作過程可能產生未曾預期的形態，而造形上的需求也可能促使我們重新思考加工方式。透過觀察、實驗與轉用既有技術，我們在這些相互作用中尋找不同的製造可能。藉由與材料開發者、科學研究者、工程師、製造業者及文化機構的合作，連結實驗研究與實際應用，從自主探索到委託專案，將研究成果轉化為物件、產品及空間構成。
                        </span>
                    </p>
                </div>

                <div class="about-image col-5">
                    <a href={`/${locale}/make-things-like-earth/`}>
                        <img
                            src="/imgs/ercoffice-position.svg"
                            alt="ercoffice diagram"
                            loading="lazy"
                        />
                    </a>
                </div>
            </section>

            <!---------------插入 MTLE 九宮格?--------->
        </div>
    </div>
</BaseLayout>
